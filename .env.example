# Grihasti — environment variables (copy to .env.local, fill in real values)

# ── Site ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://grihasti.in

# ── Database ──────────────────────────────────────────────────────────────
# A plain Postgres connection string. This is the ONLY database config, by
# design: the app uses no vendor SDK, so moving from Supabase to a self-hosted
# Postgres (Hetzner/Docker) is this line plus a pg_dump/pg_restore.
# Supabase: Project Settings -> Database -> Connection string (URI); use the
# pooler on port 6543 for serverless.
DATABASE_URL=
# PGSSL=disable          # only for a self-hosted DB on a private network
# PGPOOL_MAX=10

# For the restore drill only — needs CREATEDB. Never used by the app.
ADMIN_DATABASE_URL=

# ── Backups (the ledger is money owed; local-only is not a backup) ────────
BACKUP_DIR=/var/backups/grihasti
RETAIN_DAYS=30
RCLONE_REMOTE=            # e.g. b2:grihasti-backups — MUST be set before go-live

# ── Payments ──────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Shipping ──────────────────────────────────────────────────────────────
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=

# ── Email (OTP + transactional) ───────────────────────────────────────────
# Auth is email-OTP for launch. Phone-OTP needs TRAI DLT registration
# (1-3 weeks) and is deferred; MSG91 keys go here when that clears.
RESEND_API_KEY=
EMAIL_FROM="Grihasti <hello@grihasti.in>"
# MSG91_AUTH_KEY=
# MSG91_DLT_TEMPLATE_ID=

# ── Marketing ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_META_PIXEL_ID=
META_CAPI_TOKEN=

# ── Business config ───────────────────────────────────────────────────────
# Spec §3.1 says 0.12, but the 12% GST slab was collapsed in the Sept 2025
# restructure. Default is 18% for candles (HSN 3406). CONFIRM WITH YOUR CA
# BEFORE GO-LIVE — this number goes on every invoice.
GST_RATE=0.18
