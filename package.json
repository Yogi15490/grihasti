{
  "name": "grihasti",
  "version": "0.1.0",
  "private": true,
  "description": "Grihasti \u2014 Rakhi commerce + referral portal (grihasti.in)",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
